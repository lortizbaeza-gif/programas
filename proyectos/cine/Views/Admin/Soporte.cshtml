@model IEnumerable<Cine.Models.TicketSoporte>
@{ Layout="_AdminLayout"; ViewData["Title"]="Soporte"; }
<div class="container-fluid"><h2 class="fw-bold mb-4">Atención al cliente y soporte</h2>@if(TempData["Error"]!=null){<div class="alert alert-warning">@TempData["Error"]</div>}<div class="card p-4 border-0 shadow-sm mb-4"><form asp-action="CrearTicket" class="row g-3"><div class="col-md-3"><input name="Cliente" class="form-control" placeholder="Cliente"/></div><div class="col-md-2"><select name="Tipo" class="form-select"><option>Queja</option><option>Reembolso</option><option>Factura</option><option>Objeto perdido</option><option>Sugerencia</option></select></div><div class="col-md-5"><input name="Descripcion" class="form-control" placeholder="Descripción del caso" required/></div><div class="col-md-2"><button class="btn btn-danger w-100">Registrar</button></div></form></div><div class="card border-0 shadow-sm"><table class="table mb-0"><thead class="table-light"><tr><th>Folio</th><th>Cliente / caso</th><th>Tipo</th><th>Estado</th><th></th></tr></thead><tbody>@foreach(var t in Model){<tr><td>#@t.Id</td><td>@t.Cliente<br/><small>@t.Descripcion</small></td><td>@t.Tipo</td><td>@t.Estado</td><td>@if(t.Estado!="Resuelto"){<form asp-action="ResolverTicket" class="d-flex gap-2"><input type="hidden" name="id" value="@t.Id"/><input name="resolucion" class="form-control form-control-sm" placeholder="Resolución"/><button class="btn btn-sm btn-success">Resolver</button></form>}else{@t.Resolucion}</td></tr>}</tbody></table></div></div>

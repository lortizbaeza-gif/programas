@model Cine.Models.Sucursal
@{ Layout="_AdminLayout"; ViewData["Title"]="Sucursal"; }
<div class="container-fluid"><h2 class="fw-bold mb-4">Nueva sucursal</h2><div class="card p-4 border-0 shadow-sm"><form asp-action="CrearSucursal"><div class="row g-3 mb-4"><div class="col-md-6"><label class="form-label">Nombre</label><input asp-for="Nombre" class="form-control" required/></div><div class="col-md-6"><label class="form-label">Ciudad</label><input asp-for="Ciudad" class="form-control" required/></div><div class="col-12"><label class="form-label">Dirección</label><input asp-for="Direccion" class="form-control" required/></div><div class="col-md-6"><label class="form-label">Apertura</label><input asp-for="HorarioApertura" type="time" class="form-control"/></div><div class="col-md-6"><label class="form-label">Cierre</label><input asp-for="HorarioCierre" type="time" class="form-control"/></div></div><button class="btn btn-danger">Guardar</button> <a asp-action="Sucursales" class="btn btn-outline-secondary">Cancelar</a></form></div></div>

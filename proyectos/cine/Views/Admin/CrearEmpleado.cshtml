@model Cine.Models.Empleado
@{ Layout="_AdminLayout"; ViewData["Title"]="Empleado"; }
<div class="container-fluid"><h2 class="fw-bold mb-4">Registrar empleado</h2><div class="card p-4 border-0 shadow-sm"><form asp-action="CrearEmpleado"><div class="row g-3 mb-4"><div class="col-md-6"><label class="form-label">Nombre completo</label><input asp-for="Nombre" class="form-control" required/></div><div class="col-md-6"><label class="form-label">Puesto</label><select asp-for="Puesto" class="form-select"><option>Cajero</option><option>Dulcería</option><option>Proyeccionista</option><option>Limpieza</option><option>Seguridad</option><option>Gerente</option><option>Mantenimiento</option></select></div><div class="col-md-4"><label class="form-label">Turno</label><select asp-for="Turno" class="form-select"><option>Matutino</option><option>Vespertino</option><option>Nocturno</option></select></div><div class="col-md-4"><label class="form-label">Teléfono</label><input asp-for="Telefono" class="form-control"/></div><div class="col-md-4"><label class="form-label">Correo</label><input asp-for="Email" type="email" class="form-control"/></div><div class="col-md-4"><label class="form-label">Salario</label><input asp-for="Salario" type="number" step="0.01" class="form-control"/></div></div><button class="btn btn-danger">Guardar</button> <a asp-action="Empleados" class="btn btn-outline-secondary">Cancelar</a></form></div></div>

@model IEnumerable<Cine.Models.ProductoAlimento>
@{ Layout="_AdminLayout"; ViewData["Title"]="Inventario"; }
<div class="container-fluid"><h2 class="fw-bold mb-4">Inventario de dulcería</h2>@if(TempData["Error"] != null){<div class="alert alert-warning">@TempData["Error"]</div>}<div class="card p-4 border-0 shadow-sm mb-4"><h5>Registrar movimiento</h5><form asp-action="AjustarInventario" method="post" class="row g-3"><div class="col-md-4"><select name="productoId" class="form-select" required><option value="">Producto</option>@foreach(var p in Model){<option value="@p.Id">@p.Nombre</option>}</select></div><div class="col-md-2"><select name="tipo" class="form-select"><option>Entrada</option><option>Salida</option></select></div><div class="col-md-2"><input name="cantidad" type="number" min="1" class="form-control" placeholder="Cantidad" required/></div><div class="col-md-3"><input name="motivo" class="form-control" placeholder="Compra, merma, ajuste..." required/></div><div class="col-md-1"><button class="btn btn-danger w-100">Guardar</button></div></form></div><div class="card border-0 shadow-sm"><table class="table mb-0"><thead class="table-light"><tr><th>Producto</th><th>Existencia</th><th>Mínimo</th><th>Alerta</th></tr></thead><tbody>@foreach(var p in Model){<tr><td>@p.Nombre</td><td>@p.Existencia</td><td>@p.StockMinimo</td><td>@if(p.Existencia <= p.StockMinimo){<span class="badge bg-warning text-dark">Reabastecer</span>}else{<span class="badge bg-success">Disponible</span>}</td></tr>}</tbody></table></div></div>

@model IEnumerable<Cine.Models.Orden>
@{ Layout="_AdminLayout"; ViewData["Title"]="Ventas"; }
<div class="container-fluid"><h2 class="fw-bold mb-4">Ventas, cancelaciones y reembolsos</h2><div class="card border-0 shadow-sm"><div class="table-responsive"><table class="table align-middle mb-0"><thead class="table-light"><tr><th>Folio</th><th>Fecha</th><th>Conceptos</th><th>Beneficio</th><th>Total</th><th>Estado</th><th></th></tr></thead><tbody>@foreach(var orden in Model){<tr><td>#@orden.Id</td><td>@orden.Fecha.ToString("dd/MM/yyyy HH:mm")</td><td>@string.Join(", ", orden.Detalles.Select(d => $"{d.Concepto} x{d.Cantidad}"))</td><td>@(string.IsNullOrWhiteSpace(orden.CodigoBeneficio) ? "—" : orden.CodigoBeneficio)</td><td>$@orden.Total.ToString("N2")</td><td><span class="badge @(orden.Estado=="Pagada" ? "bg-success" : "bg-secondary")">@orden.Estado</span></td><td>@if(orden.Estado=="Pagada"){<form asp-action="CancelarVenta" class="d-flex gap-1"><input type="hidden" name="id" value="@orden.Id"/><input name="motivo" class="form-control form-control-sm" placeholder="Motivo" required/><button class="btn btn-sm btn-outline-danger">Reembolsar</button></form>}</td></tr>}</tbody></table></div></div></div>

@model Cine.Models.Sala
@{
    var sucursales = ViewBag.Sucursales as List<Cine.Models.Sucursal> ?? new();
}

<div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
<div class="row g-3 mb-4">
    <div class="col-md-12">
        <label asp-for="SucursalId" class="form-label">Sucursal</label>
        <select asp-for="SucursalId" class="form-select" required>
            <option value="">Selecciona la sucursal</option>
            @foreach (var sucursal in sucursales) { <option value="@sucursal.Id">@sucursal.Nombre — @sucursal.Ciudad</option> }
        </select>
        <span asp-validation-for="SucursalId" class="text-danger"></span>
    </div>
    <div class="col-md-4"><label asp-for="Nombre" class="form-label">Nombre</label><input asp-for="Nombre" class="form-control" placeholder="Ej. Sala VIP A" /></div>
    <div class="col-md-2"><label asp-for="Letra" class="form-label">Letra</label><select asp-for="Letra" class="form-select">@foreach(var letra in new[]{"A","B","C","D","E","F"}){<option value="@letra">@letra</option>}</select></div>
    <div class="col-md-3"><label asp-for="Tipo" class="form-label">Experiencia</label><select asp-for="Tipo" class="form-select"><option>Normal</option><option>VIP</option></select><small class="text-muted">VIP indica servicio premium.</small></div>
    <div class="col-md-3"><label asp-for="Formato" class="form-label">Formato principal</label><select asp-for="Formato" class="form-select"><option>2D</option><option>3D</option><option>4D</option></select></div>
    <div class="col-md-3">
        <label class="form-label d-block">Capacidades</label>
        <div class="form-check form-check-inline"><input asp-for="Soporta3D" class="form-check-input" /><label asp-for="Soporta3D" class="form-check-label">3D</label></div>
        <div class="form-check form-check-inline"><input asp-for="Soporta4D" class="form-check-input" /><label asp-for="Soporta4D" class="form-check-label">4D</label></div>
    </div>
    <div class="col-md-4"><label asp-for="Filas" class="form-label">Filas de asientos</label><input asp-for="Filas" type="number" min="1" max="26" class="form-control" /><small class="text-muted">Para VIP A–E, usa 5 filas.</small></div>
    <div class="col-md-4"><label asp-for="Columnas" class="form-label">Asientos por fila</label><input asp-for="Columnas" type="number" min="1" max="30" class="form-control" /></div>
    <div class="col-md-4"><label asp-for="PasilloDespuesColumna" class="form-label">Pasillo central VIP</label><input asp-for="PasilloDespuesColumna" type="number" min="0" max="29" class="form-control" /><small class="text-muted">VIP usa este pasillo; Normal crea tres bloques y 4D agrupa parejas.</small></div>
    <div class="col-12"><hr /><h5>Precios de esta sala</h5><small id="price-limit-help" class="text-muted"></small></div>
    <div class="col-md-4"><label asp-for="PrecioAdulto" class="form-label">Adulto</label><div class="input-group"><span class="input-group-text">$</span><input id="PrecioAdulto" name="PrecioAdulto" value="@Model.PrecioAdulto.ToString("0.00", System.Globalization.CultureInfo.InvariantCulture)" type="number" min="0" max="90" step="0.01" class="form-control room-price" /></div><span asp-validation-for="PrecioAdulto" class="text-danger"></span></div>
    <div class="col-md-4"><label asp-for="PrecioAlumno" class="form-label">Alumno</label><div class="input-group"><span class="input-group-text">$</span><input id="PrecioAlumno" name="PrecioAlumno" value="@Model.PrecioAlumno.ToString("0.00", System.Globalization.CultureInfo.InvariantCulture)" type="number" min="0" max="90" step="0.01" class="form-control room-price" /></div><span asp-validation-for="PrecioAlumno" class="text-danger"></span></div>
    <div class="col-md-4"><label asp-for="PrecioNino" class="form-label">Niño</label><div class="input-group"><span class="input-group-text">$</span><input id="PrecioNino" name="PrecioNino" value="@Model.PrecioNino.ToString("0.00", System.Globalization.CultureInfo.InvariantCulture)" type="number" min="0" max="90" step="0.01" class="form-control room-price" /></div><span asp-validation-for="PrecioNino" class="text-danger"></span></div>
</div>

<script>
(() => {
    const type = document.getElementById('Tipo');
    const help = document.getElementById('price-limit-help');
    const prices = document.querySelectorAll('.room-price');
    const updateLimit = () => {
        const maximum = type?.value === 'VIP' ? 180 : 90;
        prices.forEach(input => input.max = maximum);
        if (help) help.textContent = `${type?.value === 'VIP' ? 'Sala VIP' : 'Sala normal'}: máximo $${maximum.toFixed(2)} MXN por boleto.`;
    };
    type?.addEventListener('change', updateLimit);
    updateLimit();
})();
</script>

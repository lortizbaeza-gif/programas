@model Cine.Models.Promocion
@{ Layout="_AdminLayout"; ViewData["Title"]="Promoción"; }
<div class="container-fluid"><h2 class="fw-bold mb-4">Nueva promoción</h2><div class="card p-4 border-0 shadow-sm"><form asp-action="CrearPromocion" method="post"><div asp-validation-summary="ModelOnly" class="text-danger"></div><div class="row g-3 mb-4"><div class="col-md-6"><label class="form-label">Nombre</label><input asp-for="Nombre" class="form-control" required/></div><div class="col-md-6"><label class="form-label">Código para cliente</label><input asp-for="Codigo" class="form-control" required/></div><div class="col-md-4"><label class="form-label">Descuento (%)</label><input asp-for="DescuentoPorcentaje" type="number" min="1" max="100" class="form-control"/></div><div class="col-md-4"><label class="form-label">Inicio</label><input asp-for="Inicio" type="date" class="form-control"/></div><div class="col-md-4"><label class="form-label">Fin</label><input asp-for="Fin" type="date" class="form-control"/></div></div><button class="btn btn-danger">Guardar promoción</button> <a asp-action="Promociones" class="btn btn-outline-secondary">Cancelar</a></form></div></div>

@model IEnumerable<Cine.Models.Activo>
@{ Layout="_AdminLayout"; ViewData["Title"]="Activos"; }
<div class="container-fluid"><h2 class="fw-bold mb-4">Activos fijos y equipo</h2><div class="card p-4 border-0 shadow-sm mb-4"><form asp-action="CrearActivo" class="row g-3"><div class="col-md-3"><input name="Nombre" class="form-control" placeholder="Activo" required/></div><div class="col-md-2"><select name="Categoria" class="form-select"><option>Equipo</option><option>Proyección</option><option>Mobiliario</option><option>Seguridad</option></select></div><div class="col-md-3"><input name="Ubicacion" class="form-control" placeholder="Ubicación" required/></div><div class="col-md-2"><input name="Valor" type="number" step="0.01" class="form-control" placeholder="Valor" required/></div><div class="col-md-1"><select name="Estado" class="form-select"><option>Operativo</option><option>Mantenimiento</option><option>Baja</option></select></div><div class="col-md-1"><button class="btn btn-danger w-100">+</button></div></form></div><div class="card border-0 shadow-sm"><table class="table mb-0"><thead class="table-light"><tr><th>Activo</th><th>Categoría</th><th>Ubicación</th><th>Valor</th><th>Estado</th></tr></thead><tbody>@foreach(var a in Model){<tr><td>@a.Nombre</td><td>@a.Categoria</td><td>@a.Ubicacion</td><td>$@a.Valor.ToString("N2")</td><td>@a.Estado</td></tr>}</tbody></table></div></div>

@model IEnumerable<Cine.Models.Proveedor>
@{ Layout="_AdminLayout"; ViewData["Title"]="Proveedores"; }
<div class="container-fluid"><div class="d-flex justify-content-between mb-4"><h2 class="fw-bold">Proveedores</h2><a asp-action="CrearProveedor" class="btn btn-danger">Nuevo proveedor</a></div><div class="card border-0 shadow-sm"><table class="table mb-0"><thead class="table-light"><tr><th>Empresa</th><th>Contacto</th><th>Teléfono</th><th>Correo</th><th>Estado</th><th></th></tr></thead><tbody>@foreach(var p in Model){<tr><td>@p.Nombre</td><td>@p.Contacto</td><td>@p.Telefono</td><td>@p.Email</td><td>@(p.Activo ? "Activo" : "Inactivo")</td><td><a asp-action="EditarProveedor" asp-route-id="@p.Id" class="btn btn-sm btn-outline-primary">Editar</a></td></tr>}</tbody></table></div></div>

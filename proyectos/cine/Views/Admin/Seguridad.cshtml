@model IEnumerable<Cine.Models.UsuarioSistema>
@{ Layout="_AdminLayout"; ViewData["Title"]="Seguridad"; }
<div class="container-fluid"><h2 class="fw-bold mb-4">Seguridad, usuarios y auditoría</h2>@if(TempData["Error"] != null){<div class="alert alert-warning">@TempData["Error"]</div>}<div class="card p-4 border-0 shadow-sm mb-4"><h5>Nuevo usuario del sistema</h5><form asp-action="CrearUsuario" class="row g-3"><div class="col-md-3"><input name="Nombre" class="form-control" placeholder="Nombre" required/></div><div class="col-md-2"><input name="Usuario" class="form-control" placeholder="Usuario" required/></div><div class="col-md-3"><select name="Rol" class="form-select"><option>Administrador</option><option>Gerente</option><option>Cajero</option><option>Dulcería</option><option>Proyeccionista</option><option>Auditor</option></select></div><div class="col-md-2"><div class="form-check pt-2"><input name="DobleFactor" value="true" type="checkbox" class="form-check-input"/><label class="form-check-label">Doble factor</label></div></div><div class="col-md-2"><button class="btn btn-danger w-100">Crear</button></div></form></div><div class="row g-4"><div class="col-lg-7"><div class="card border-0 shadow-sm"><table class="table mb-0"><thead class="table-light"><tr><th>Usuario</th><th>Rol</th><th>2FA</th><th>Estado</th><th></th></tr></thead><tbody>@foreach(var u in Model){<tr><td>@u.Nombre<br/><small>@u.Usuario</small></td><td>@u.Rol</td><td>@(u.DobleFactor ? "Sí":"No")</td><td>@(u.Activo ? "Activo":"Bloqueado")</td><td><form asp-action="CambiarEstadoUsuario"><input type="hidden" name="id" value="@u.Id"/><button class="btn btn-sm btn-outline-dark">@(u.Activo ? "Bloquear":"Activar")</button></form></td></tr>}</tbody></table></div></div><div class="col-lg-5"><div class="card border-0 shadow-sm p-3"><h5>Bitácora de auditoría</h5><ul class="list-group list-group-flush">@foreach(var b in ViewBag.Bitacora){<li class="list-group-item"><small>@b.Fecha.ToString("dd/MM HH:mm") · @b.Usuario</small><br/>@b.Accion</li>}</ul></div></div></div></div>

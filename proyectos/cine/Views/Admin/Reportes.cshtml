@model IEnumerable<Cine.Models.Orden>
@{ Layout = "_AdminLayout"; ViewData["Title"] = "Reportes"; }
<div class="container-fluid"><h2 class="fw-bold mb-4">Corte de ventas</h2><form method="get" class="card border-0 shadow-sm rounded-4 p-3 mb-4"><div class="row align-items-end g-3"><div class="col-md-4"><label class="form-label">Desde</label><input name="desde" type="date" value="@ViewBag.Desde" class="form-control" /></div><div class="col-md-4"><label class="form-label">Hasta</label><input name="hasta" type="date" value="@ViewBag.Hasta" class="form-control" /></div><div class="col-md-2"><button class="btn btn-dark w-100">Consultar</button></div></div></form><div class="row g-3 mb-4"><div class="col-md-4"><div class="card p-3 border-0 shadow-sm"><small>Ventas del periodo</small><h3>$@ViewBag.Total.ToString("N2")</h3></div></div><div class="col-md-4"><div class="card p-3 border-0 shadow-sm"><small>Órdenes pagadas</small><h3>@ViewBag.Ordenes</h3></div></div><div class="col-md-4"><div class="card p-3 border-0 shadow-sm"><small>Boletos vendidos</small><h3>@ViewBag.Boletos</h3></div></div></div><div class="card border-0 shadow-sm rounded-4"><table class="table mb-0"><thead class="table-light"><tr><th>Folio</th><th>Fecha</th><th>Pago</th><th class="text-end">Total</th></tr></thead><tbody>@foreach(var orden in Model){<tr><td>#@orden.Id</td><td>@orden.Fecha.ToString("dd/MM/yyyy HH:mm")</td><td>@orden.MetodoPago</td><td class="text-end">$@orden.Total.ToString("N2")</td></tr>}</tbody></table></div></div>

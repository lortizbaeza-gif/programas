@model Cine.Models.Pelicula
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Crear película";
    var salas = ViewBag.Salas as List<Cine.Models.Sala> ?? new();
    var funciones = ViewBag.Funciones as List<Cine.Models.FuncionPeliculaInput> ?? new();
    var sucursales = ViewBag.Sucursales as List<Cine.Models.Sucursal> ?? new();
    var ocupaciones = ViewBag.Ocupaciones as Dictionary<int, List<Cine.Models.Horario>> ?? new();
}

<div class="container-fluid">
    <h2 class="fw-bold mb-2">Crear película y funciones</h2>
    <p class="text-muted mb-3">Primero elige una sucursal; después programa la película únicamente en sus salas disponibles.</p>
    <form method="get" class="card border-0 shadow-sm rounded-4 p-3 mb-4">
        <label for="sucursal-selector" class="form-label fw-semibold">Sucursal donde se proyectará</label>
        <select id="sucursal-selector" name="sucursalId" class="form-select" onchange="this.form.submit()">
            @foreach (var sucursal in sucursales)
            {
                if (sucursal.Id == (int?)ViewBag.SucursalId) { <option value="@sucursal.Id" selected>@sucursal.Nombre — @sucursal.Ciudad</option> }
                else { <option value="@sucursal.Id">@sucursal.Nombre — @sucursal.Ciudad</option> }
            }
        </select>
    </form>
    <div class="card border-0 shadow-sm rounded-4 p-4">
        <form asp-action="CrearPelicula" method="post" enctype="multipart/form-data">
            <input type="hidden" name="sucursalId" value="@ViewBag.SucursalId" />
            <div asp-validation-summary="All" class="text-danger mb-3"></div>
            <div class="row g-3">
                <div class="col-md-6"><label class="form-label">Título</label><input asp-for="Titulo" class="form-control" required /></div>
                <div class="col-md-6"><label class="form-label">Director</label><input asp-for="Director" class="form-control" required /></div>
                <div class="col-md-6">
                    <label class="form-label">Género</label>
                    <select asp-for="Genero" class="form-select" required>
                        <option value="">Selecciona un género</option>
                        <option value="Comedia">Comedia — Busca hacer reír al público</option>
                        <option value="Drama">Drama — Conflictos emocionales y situaciones serias</option>
                        <option value="Ciencia ficción">Ciencia ficción — Conceptos futuristas y tecnológicos</option>
                        <option value="Fantasía">Fantasía — Elementos mágicos o sobrenaturales</option>
                        <option value="Terror">Terror — Diseñada para asustar o provocar miedo</option>
                        <option value="Biografía">Biografía — Vida e historia de una persona real</option>
                    </select>
                </div>
                <div class="col-md-3">
                    <label class="form-label">Clasificación</label>
                    <select asp-for="Clasificacion" class="form-select">
                        <option value="AA">AA — Todo público, especialmente menores de 7 años</option>
                        <option value="A">A — Todo público, apta para menores de 12 años</option>
                        <option value="B" selected>B — Mayores de 12 años</option>
                        <option value="B15">B15 — Mayores de 15 años</option>
                        <option value="C">C — Mayores de 18 años</option>
                        <option value="D">D — Exclusiva para adultos</option>
                    </select>
                </div>
                <div class="col-md-3"><label class="form-label">Duración (minutos)</label><input asp-for="Duracion" type="number" min="1" class="form-control" required /></div>

                <div class="col-12 mt-4"><h5 class="fw-bold">Disponibilidad por sala</h5></div>
                @for (var i = 0; i < salas.Count; i++)
                {
                    var sala = salas[i];
                    var funcion = funciones.FirstOrDefault(f => f.SalaId == sala.Id) ?? new Cine.Models.FuncionPeliculaInput { SalaId = sala.Id };
                    var agenda = ocupaciones.GetValueOrDefault(sala.Id, new List<Cine.Models.Horario>());
                    <div class="col-12">
                        <div class="border rounded-4 p-3 room-availability">
                            <input type="hidden" name="funciones[@i].SalaId" value="@sala.Id" />
                            <div class="row g-3 align-items-end">
                                <div class="col-lg-4">
                                    <div class="form-check form-switch">
                                        @if (funcion.Disponible) { <input class="form-check-input availability-toggle" type="checkbox" name="funciones[@i].Disponible" value="true" checked /> }
                                        else { <input class="form-check-input availability-toggle" type="checkbox" name="funciones[@i].Disponible" value="true" /> }
                                        <label class="form-check-label fw-semibold">Sala @sala.Letra — @sala.Tipo / @sala.Formato</label>
                                    </div>
                                    <div class="mt-2"><span class="badge bg-secondary">2D</span> @if(sala.Soporta3D){<span class="badge bg-dark">3D</span>} @if(sala.Soporta4D){<span class="badge bg-danger">4D</span>} @if(sala.Tipo=="VIP"){<span class="badge bg-warning text-dark">VIP</span>}</div>
                                    @if (agenda.Any())
                                    {
                                        <div class="room-schedule mt-3">
                                            <small class="fw-bold">Horarios ocupados:</small>
                                            @foreach (var ocupada in agenda)
                                            {
                                                var inicio = ocupada.Fecha.Date.Add(ocupada.Hora);
                                                var fin = inicio.AddMinutes(ocupada.Pelicula?.Duracion ?? 0);
                                                <div><span>@inicio.ToString("dd/MM · HH:mm")–@fin.ToString("HH:mm")</span> @ocupada.Pelicula?.Titulo</div>
                                            }
                                        </div>
                                    }
                                    else
                                    {
                                        <div class="text-success small mt-2">Sin funciones próximas registradas.</div>
                                    }
                                </div>
                                <div class="col-md-3 col-lg-2"><label class="form-label">Fecha</label><input name="funciones[@i].Fecha" type="date" value="@funcion.Fecha.ToString("yyyy-MM-dd")" class="form-control function-field" /></div>
                                <div class="col-md-3 col-lg-2"><label class="form-label">Hora</label><input name="funciones[@i].Hora" type="time" value="@funcion.Hora.ToString(@"hh\:mm")" class="form-control function-field" /></div>
                                <div class="col-md-3 col-lg-2">
                                    <label class="form-label">Formato</label>
                                    <select name="funciones[@i].Formato" class="form-select function-field">
                                        <option value="2D">2D</option>
                                        @if (sala.Soporta3D) { <option value="3D">3D</option> }
                                        @if (sala.Soporta4D) { <option value="4D">4D</option> }
                                    </select>
                                </div>
                            </div>
                        </div>
                    </div>
                }
                @if (!salas.Any())
                {
                    <div class="col-12"><div class="alert alert-warning">Esta sucursal todavía no tiene salas. Registra primero una sala 2D, 3D, 4D o VIP.</div></div>
                }

                <div class="col-md-12 mt-4">
                    <label class="form-label">Póster desde tu computadora</label>
                    <input name="posterArchivo" type="file" accept="image/jpeg,image/png,image/webp,image/gif" class="form-control" onchange="previsualizarArchivo(this)" />
                    <small class="text-muted">JPG, PNG, WEBP o GIF; máximo 5 MB.</small>
                    <img id="vistaPoster" src="/images/poster-placeholder.svg" alt="Vista previa" class="mt-3 rounded border" style="width:140px;height:200px;object-fit:cover" />
                </div>
                <div class="col-12"><label class="form-label">Sinopsis</label><textarea asp-for="Sinopsis" class="form-control" rows="4" required></textarea></div>
                <div class="col-12"><div class="form-check"><input asp-for="Activa" class="form-check-input" checked /><label asp-for="Activa" class="form-check-label">Película activa en cartelera</label></div></div>
            </div>
            <div class="mt-4"><button type="submit" class="btn btn-danger">Guardar película y funciones</button> <a asp-action="Peliculas" class="btn btn-outline-secondary">Cancelar</a></div>
        </form>
    </div>
</div>

<script>
function previsualizarArchivo(input) {
    if (input.files && input.files[0]) document.getElementById('vistaPoster').src = URL.createObjectURL(input.files[0]);
}
document.querySelectorAll('.room-availability').forEach(room => {
    const toggle = room.querySelector('.availability-toggle');
    const fields = room.querySelectorAll('.function-field');
    const update = () => fields.forEach(field => field.disabled = !toggle.checked);
    toggle.addEventListener('change', update);
    update();
});
</script>

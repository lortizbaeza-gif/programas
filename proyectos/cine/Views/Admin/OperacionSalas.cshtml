@model IEnumerable<Cine.Models.OperacionSala>
@{ Layout="_AdminLayout"; ViewData["Title"]="Operación de salas"; }
<div class="container-fluid"><h2 class="fw-bold mb-4">Operación, acceso y proyección</h2><p class="text-muted">Registra checklists, incidencias, limpieza, validación de boletos y eventos de proyección.</p>@if(TempData["Error"] != null){<div class="alert alert-warning">@TempData["Error"]</div>}<div class="card p-4 border-0 shadow-sm mb-4"><form asp-action="RegistrarOperacionSala" class="row g-3"><div class="col-md-3"><select name="Sala" class="form-select"><option value="Sala 1">Sala 1</option><option value="Sala 2">Sala 2</option><option value="Lobby">Lobby</option></select></div><div class="col-md-3"><select name="Tipo" class="form-select"><option>Checklist apertura</option><option>Checklist cierre</option><option>Incidente</option><option>Validación QR</option><option>Limpieza</option><option>Proyección</option></select></div><div class="col-md-4"><input name="Descripcion" class="form-control" placeholder="Detalle de operación o código de boleto" required/></div><div class="col-md-2"><button class="btn btn-danger w-100">Registrar</button></div></form></div><div class="card border-0 shadow-sm"><table class="table mb-0"><thead class="table-light"><tr><th>Fecha</th><th>Sala</th><th>Tipo</th><th>Detalle</th><th>Estado</th><th></th></tr></thead><tbody>@foreach(var o in Model){<tr><td>@o.Fecha.ToString("dd/MM HH:mm")</td><td>@o.Sala</td><td>@o.Tipo</td><td>@o.Descripcion</td><td>@o.Estado</td><td>@if(o.Estado != "Completado"){<form asp-action="CompletarOperacionSala"><input type="hidden" name="id" value="@o.Id"/><button class="btn btn-sm btn-success">Completar</button></form>}</td></tr>}</tbody></table></div></div>

@model IEnumerable<Cine.Models.Promocion>
@{ Layout="_AdminLayout"; ViewData["Title"]="Promociones"; }
<div class="container-fluid"><div class="d-flex justify-content-between mb-4"><h2 class="fw-bold">Promociones</h2><a asp-action="CrearPromocion" class="btn btn-danger">Nueva promoción</a></div><div class="card border-0 shadow-sm"><table class="table mb-0"><thead class="table-light"><tr><th>Nombre</th><th>Código</th><th>Descuento</th><th>Vigencia</th><th>Estado</th></tr></thead><tbody>@foreach(var p in Model){<tr><td>@p.Nombre</td><td><code>@p.Codigo</code></td><td>@p.DescuentoPorcentaje.ToString("0.##")%</td><td>@p.Inicio.ToString("dd/MM/yyyy") – @p.Fin.ToString("dd/MM/yyyy")</td><td>@(p.Activa ? "Activa" : "Inactiva")</td></tr>}</tbody></table></div></div>

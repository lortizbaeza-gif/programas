@model Cine.Models.MiembroClub
@{ Layout="_AdminLayout"; ViewData["Title"]="Nuevo miembro"; }
<div class="container-fluid"><h2 class="fw-bold mb-4">Inscribir miembro al club</h2><div class="card p-4 border-0 shadow-sm"><form asp-action="CrearMiembro" method="post"><div asp-validation-summary="ModelOnly" class="text-danger"></div><div class="row g-3 mb-4"><div class="col-md-6"><label class="form-label">Nombre</label><input asp-for="Nombre" class="form-control" required/></div><div class="col-md-6"><label class="form-label">Correo</label><input asp-for="Email" type="email" class="form-control" required/></div><div class="col-md-4"><label class="form-label">Teléfono</label><input asp-for="Telefono" class="form-control"/></div><div class="col-md-4"><label class="form-label">Código (se genera si se deja vacío)</label><input asp-for="Codigo" class="form-control"/></div><div class="col-md-4"><label class="form-label">Nivel</label><select asp-for="Nivel" class="form-select"><option>Clásico</option><option>Oro</option><option>Platino</option></select></div><div class="col-md-4"><label class="form-label">Descuento (%)</label><input asp-for="DescuentoPorcentaje" type="number" min="0" max="100" class="form-control"/></div><div class="col-md-4"><label class="form-label">Puntos iniciales</label><input asp-for="Puntos" type="number" min="0" class="form-control"/></div></div><button class="btn btn-danger">Crear membresía</button> <a asp-action="Club" class="btn btn-outline-secondary">Cancelar</a></form></div></div>

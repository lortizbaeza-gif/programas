@model IEnumerable<Cine.Models.TurnoCaja>
@{ Layout="_AdminLayout"; ViewData["Title"]="Taquilla"; }
<div class="container-fluid"><h2 class="fw-bold mb-4">Taquilla y cortes de caja</h2>@if(TempData["Error"]!=null){<div class="alert alert-warning">@TempData["Error"]</div>}<div class="card p-4 border-0 shadow-sm mb-4"><h5>Abrir turno</h5><form asp-action="AbrirCaja" class="row g-3"><div class="col-md-5"><input name="cajero" class="form-control" placeholder="Nombre del cajero" required/></div><div class="col-md-4"><input name="fondoInicial" type="number" step="0.01" min="0" class="form-control" placeholder="Fondo inicial" required/></div><div class="col-md-3"><button class="btn btn-danger w-100">Abrir caja</button></div></form></div><div class="card border-0 shadow-sm"><table class="table mb-0"><thead class="table-light"><tr><th>Cajero</th><th>Apertura</th><th>Fondo</th><th>Estado</th><th></th></tr></thead><tbody>@foreach(var t in Model){<tr><td>@t.Cajero</td><td>@t.Apertura.ToString("dd/MM HH:mm")</td><td>$@t.FondoInicial.ToString("N2")</td><td>@t.Estado</td><td>@if(t.Estado=="Abierto"){<form asp-action="CerrarCaja" class="d-flex gap-2"><input type="hidden" name="id" value="@t.Id"/><input name="efectivoFinal" type="number" step="0.01" class="form-control form-control-sm" placeholder="Efectivo final" required/><input name="observaciones" class="form-control form-control-sm" placeholder="Observaciones"/><button class="btn btn-sm btn-dark">Cerrar</button></form>}else{<span>$@t.EfectivoFinal.ToString("N2")</span>}</td></tr>}</tbody></table></div></div>

@model IEnumerable<Cine.Models.OrdenMantenimiento>
@{ Layout="_AdminLayout"; ViewData["Title"]="Mantenimiento"; }
<div class="container-fluid"><h2 class="fw-bold mb-4">Mantenimiento y operación de salas</h2>@if(TempData["Error"]!=null){<div class="alert alert-warning">@TempData["Error"]</div>}<div class="card p-4 border-0 shadow-sm mb-4"><form asp-action="CrearOrdenMantenimiento" class="row g-3"><div class="col-md-3"><input name="Area" class="form-control" placeholder="Sala, lobby, proyector..." required/></div><div class="col-md-4"><input name="Descripcion" class="form-control" placeholder="Falla u orden de trabajo" required/></div><div class="col-md-2"><select name="Prioridad" class="form-select"><option>Alta</option><option selected>Media</option><option>Baja</option></select></div><div class="col-md-2"><input name="Responsable" class="form-control" placeholder="Responsable"/></div><div class="col-md-1"><button class="btn btn-danger w-100">+</button></div></form></div><div class="card border-0 shadow-sm"><table class="table mb-0"><thead class="table-light"><tr><th>Área</th><th>Descripción</th><th>Prioridad</th><th>Responsable</th><th>Estado</th></tr></thead><tbody>@foreach(var o in Model){<tr><td>@o.Area</td><td>@o.Descripcion</td><td>@o.Prioridad</td><td>@o.Responsable</td><td><form asp-action="CambiarEstadoMantenimiento"><input type="hidden" name="id" value="@o.Id"/><select name="estado" class="form-select form-select-sm" onchange="this.form.submit()">@if(o.Estado=="Pendiente"){<option selected>Pendiente</option>}else{<option>Pendiente</option>}@if(o.Estado=="En proceso"){<option selected>En proceso</option>}else{<option>En proceso</option>}@if(o.Estado=="Resuelto"){<option selected>Resuelto</option>}else{<option>Resuelto</option>}</select></form></td></tr>}</tbody></table></div></div>

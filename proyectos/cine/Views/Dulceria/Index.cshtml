@model IEnumerable<Cine.Models.ProductoAlimento>

@{
    ViewData["Title"] = "Dulcería";

    string IdCategoria(string categoria) => categoria switch
    {
        "Combo" => "combos",
        "Palomitas" => "clasicos",
        "Bebida" => "bebidas",
        "Dulce" => "dulces",
        "Extra" => "compartir",
        _ => $"categoria-{categoria.ToLowerInvariant().Replace(" ", "-")}"
    };

    string NombreCategoria(string categoria) => categoria switch
    {
        "Combo" => "Combos",
        "Palomitas" => "Clásicos",
        "Bebida" => "Bebidas",
        "Dulce" => "Dulces",
        "Extra" => "Para compartir",
        _ => categoria
    };
}

<section class="container-fluid px-lg-5 py-4 food-page">
    <nav class="food-tabs mb-5">
        <a href="#productos" class="food-tab active">Todos</a>
        @foreach (var categoria in Model.Select(p => p.Categoria).Distinct())
        {
            <a href="#@IdCategoria(categoria)" class="food-tab">@NombreCategoria(categoria)</a>
        }
    </nav>
    @if (TempData["ErrorCarrito"] != null) { <div class="alert alert-warning rounded-4">@TempData["ErrorCarrito"]</div> }
    @if (ViewBag.MiembroClub != null)
    {
        <div class="alert alert-danger border-0 rounded-4 d-flex justify-content-between align-items-center mb-4"><div><strong>Beneficio Club @ViewBag.MiembroClub.Nivel activo</strong><br/>Tienes @ViewBag.MiembroClub.DescuentoPorcentaje.ToString("0.##")% de descuento automático en dulcería.</div><span class="badge bg-light text-danger fs-6">@ViewBag.MiembroClub.Codigo</span></div>
    }
    else
    {
        <div class="alert alert-light border rounded-4 mb-4">¿Quieres promociones exclusivas en combos? <a asp-controller="Club" asp-action="Planes" class="alert-link">Únete al Club de Cine</a>.</div>
    }

    <div class="row g-5">
        <div class="col-xl-9" id="productos">
            @foreach (var grupo in Model.GroupBy(p => p.Categoria))
            {
                <section class="mb-5 food-category-section" id="@IdCategoria(grupo.Key)">
                    <h2 class="food-section-title">@NombreCategoria(grupo.Key)</h2>
                    <div class="food-grid">
                    @foreach (var producto in grupo)
                    {
                <div class="card food-card h-100 border-0 overflow-hidden">
                    <img src="@(string.IsNullOrWhiteSpace(producto.ImagenUrl) ? "/images/poster-placeholder.svg" : producto.ImagenUrl)" class="card-img-top" alt="@producto.Nombre" style="height: 220px; object-fit: cover;" onerror="this.onerror=null;this.src='/images/poster-placeholder.svg';" />
                    <div class="card-body d-flex flex-column">
                        <div class="d-flex justify-content-between align-items-start mb-2">
                            <h5 class="card-title fw-bold">@producto.Nombre</h5>
                            <span class="food-price">$@producto.Precio.ToString("N2")</span>
                        </div>
                        <p class="text-muted">@producto.Descripcion</p>
                        <div class="mt-auto d-flex justify-content-between align-items-center">
                            <div class="d-flex gap-2">
                                @if (producto.Existencia > 0) { <form asp-action="AgregarAlCarrito" method="post">
                                    <input type="hidden" name="id" value="@producto.Id" />
                                    <button type="submit" class="btn btn-primary">Agregar</button>
                                </form> } else { <span class="badge bg-secondary py-2">Agotado</span> }
                                <a asp-action="Personalizar" asp-route-id="@producto.Id" class="btn btn-outline-danger">Personalizar</a>
                            </div>
                        </div>
                    </div>
                </div>
                    }
                    </div>
                </section>
            }
        </div>
        <aside class="col-xl-3">
            <div class="public-cart">
                <div class="public-cart-head"><span>🛒 Tu carrito</span><strong>$@(((decimal)ViewBag.CarritoTotal).ToString("N2"))</strong></div>
                <div class="public-cart-body">
                    <p class="cart-label">Alimentos (@ViewBag.CarritoCantidad)</p>
                    @if ((int)ViewBag.CarritoCantidad == 0)
                    {
                        <div class="empty-cart">🥤 <span>No has agregado alimentos a tu orden</span></div>
                    }
                    else
                    {
                        <div class="cart-ready"><strong>@ViewBag.CarritoCantidad producto(s)</strong><span>Listos para continuar</span></div>
                    }
                    <div class="cart-total"><span>Subtotal</span><strong>$@(((decimal)ViewBag.CarritoTotal).ToString("N2"))</strong><hr/><span class="total-word">Total</span><b>$@(((decimal)ViewBag.CarritoTotal).ToString("N2"))</b></div>
                    <a asp-action="Carrito" class="btn btn-primary w-100 mt-3">Ver mi carrito</a>
                </div>
            </div>
        </aside>
    </div>
</section>

@section Scripts {
    <script>
        document.querySelectorAll('.food-tab').forEach(tab => {
            tab.addEventListener('click', event => {
                const target = document.querySelector(tab.getAttribute('href'));
                if (!target) return;

                event.preventDefault();
                document.querySelectorAll('.food-tab').forEach(item => item.classList.remove('active'));
                tab.classList.add('active');
                target.scrollIntoView({ behavior: 'smooth', block: 'start' });
                history.replaceState(null, '', tab.getAttribute('href'));
            });
        });
    </script>
}

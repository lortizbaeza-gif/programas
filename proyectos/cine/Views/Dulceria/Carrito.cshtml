@model List<Cine.Models.ItemCarritoDulceria>

@{
    ViewData["Title"] = "Mi Carrito";
}

<div class="container py-5">
    <div class="row mb-4">
        <div class="col-12">
            <h1 class="fw-bold mb-2">Mi Carrito de Compras</h1>
            <p class="text-muted">Revisa tus productos antes de ir al checkout</p>
        </div>
    </div>

    @if (Model == null || Model.Count == 0)
    {
        <div class="row">
            <div class="col-12">
                <div class="alert alert-info text-center py-5">
                    <h5>Tu carrito está vacío</h5>
                    <p class="mb-3">Agrega productos de dulcería para comenzar tu pedido</p>
                    <a asp-action="Index" class="btn btn-danger">Volver a Dulcería</a>
                </div>
            </div>
        </div>
    }
    else
    {
        <div class="row">
            <div class="col-lg-8">
                <div class="card border-0 shadow-sm rounded-4 p-4 mb-4">
                    <h5 class="fw-bold mb-3">Productos en tu carrito</h5>
                    <div class="table-responsive">
                        <table class="table table-hover">
                            <thead>
                                <tr class="border-bottom">
                                    <th>Producto</th>
                                    <th>Precio</th>
                                    <th></th>
                                </tr>
                            </thead>
                            <tbody>
                                @for (int i = 0; i < Model.Count; i++)
                                {
                                    var item = Model[i];
                                    var producto = item.Producto!;
                                    <tr class="align-middle">
                                        <td>
                                            <div class="d-flex align-items-center">
                                                <img src="@producto.ImagenUrl" alt="@producto.Nombre" style="width: 60px; height: 60px; object-fit: cover; border-radius: 8px; margin-right: 15px;">
                                                <div>
                                                    <h6 class="mb-1">@producto.Nombre</h6>
                                                    <small class="text-muted">@producto.Categoria</small>
                                                    @{
                                                        var personalizacion = item.DescripcionPersonalizacion();
                                                    }
                                                    @if (!string.IsNullOrWhiteSpace(personalizacion))
                                                    {
                                                        <div><small class="text-danger">@personalizacion</small></div>
                                                    }
                                                </div>
                                            </div>
                                        </td>
                                        <td>
                                            <strong>$@producto.Precio.ToString("N2")</strong>
                                        </td>
                                        <td class="text-end">
                                            <form asp-action="EliminarDelCarrito" method="post" class="d-inline">
                                                <input type="hidden" name="index" value="@i" />
                                                <button type="submit" class="btn btn-sm btn-outline-danger">Eliminar</button>
                                            </form>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>

            <div class="col-lg-4">
                <div class="card border-0 shadow-sm rounded-4 p-4 sticky-top" style="top: 20px;">
                    <h5 class="fw-bold mb-3">Resumen del carrito</h5>

                    <div class="mb-3">
                        <small class="text-muted">Productos: <strong>@Model.Count</strong></small><br>
                        <small class="text-muted">Subtotal: <strong>$@Model.Sum(i => i.Producto!.Precio).ToString("N2")</strong></small>
                    </div>

                    <hr>

                    <h6 class="fw-bold mb-3">Total: <span class="text-danger">$@Model.Sum(i => i.Producto!.Precio).ToString("N2")</span></h6>

                    <div class="d-grid gap-2">
                        <a asp-controller="Checkout" asp-action="Resumen" class="btn btn-danger btn-lg rounded-3">
                            Proceder a Checkout
                        </a>
                        <a asp-action="Index" class="btn btn-outline-secondary btn-lg rounded-3">
                            Continuar comprando
                        </a>
                    </div>

                    <hr class="my-3">

                    <form asp-action="LimpiarCarrito" method="post">
                        <button type="submit" class="btn btn-outline-danger w-100">Vaciar carrito</button>
                    </form>
                </div>
            </div>
        </div>
    }
</div>

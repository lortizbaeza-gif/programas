@model Cine.Models.Orden

@{
    ViewData["Title"] = "Resumen de compra";
}

<section class="container py-5">
    <div class="row g-4">
        <div class="col-lg-7">
            <div class="card border-0 shadow-sm rounded-4 p-4">
                <h2 class="fw-bold mb-3">Resumen de tu compra</h2>
                <ul class="list-group list-group-flush">
                    @foreach (var detalle in Model.Detalles)
                    {
                        <li class="list-group-item d-flex justify-content-between align-items-center">
                            <span>@detalle.Concepto x @detalle.Cantidad</span>
                            <span>$@((detalle.PrecioUnitario * detalle.Cantidad).ToString("N2"))</span>
                        </li>
                    }
                </ul>
                <div class="mt-3 text-end fw-bold fs-4">Total: $@Model.Total.ToString("N2")</div>
                @if (Model.Descuento > 0)
                {
                    <div class="text-end text-success">Descuento aplicado: -$@Model.Descuento.ToString("N2")</div>
                }
                <div class="mt-2 text-end text-muted">Asientos seleccionados: @ViewBag.AsientosSeleccionados</div>
            </div>
        </div>

        <div class="col-lg-5">
            <div class="card border-0 shadow-sm rounded-4 p-4 mb-4">
                <h4 class="fw-bold mb-3">Agregar más productos</h4>
                <a asp-controller="Dulceria" asp-action="Index" class="btn btn-outline-danger w-100">Ir a Dulcería</a>
            </div>
            <div class="card border-0 shadow-sm rounded-4 p-4 payment-card">
                <h3 class="fw-bold mb-3">Datos de pago</h3>
                <form asp-action="Pagar" method="post">
                    <div class="mb-3">
                        <label class="form-label">Código de Club o promoción</label>
                        <input class="form-control" name="codigoBeneficio" placeholder="Ej. CLUB12345 o PROMO10" />
                        <small class="text-muted">Ingresa tu código para obtener el beneficio al pagar.</small>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Nombre del titular</label>
                        <input class="form-control" name="Titular" autocomplete="cc-name" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Número de tarjeta</label>
                        <input class="form-control" name="NumeroTarjeta" autocomplete="cc-number" inputmode="numeric" required />
                    </div>
                    <div class="row">
                        <div class="col-6 mb-3">
                            <label class="form-label">Vencimiento</label>
                            <input class="form-control" name="Vencimiento" autocomplete="cc-exp" inputmode="numeric" required />
                        </div>
                        <div class="col-6 mb-3">
                            <label class="form-label">CVV</label>
                            <input class="form-control" name="Cvv" autocomplete="cc-csc" inputmode="numeric" required />
                        </div>
                    </div>
                    <button type="submit" class="btn btn-danger w-100">Pagar</button>
                </form>
            </div>
        </div>
    </div>
</section>

@model Cine.Models.Orden

@{
    ViewData["Title"] = "Ticket";
}

<section class="container py-5">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="card border-0 shadow rounded-4 p-4 text-center">
                <div class="mb-3">
                    <span class="badge bg-success rounded-pill px-3 py-2">Pago aprobado</span>
                </div>
                <h1 class="fw-bold mb-3">¡Gracias por tu compra!</h1>
                <p class="text-muted">Tu orden ha sido registrada correctamente.</p>

                <div class="border rounded-4 p-4 my-4">
                    <h3 class="fw-bold">Orden #@Model.Id</h3>
                    <p class="mb-1">Fecha: @Model.Fecha.ToString("dd/MM/yyyy HH:mm")</p>
                    <p class="mb-1">Método de pago: @Model.MetodoPago</p>
                    <p class="fw-bold fs-4">Total: $@Model.Total.ToString("N2")</p>
                </div>

                <div class="border rounded-4 p-4 mb-3">
                    <h5 class="fw-bold">Código de barras</h5>
                    <div class="fs-1 fw-bold tracking-wide">|| || || || || ||</div>
                    <p class="text-muted mt-2">Escanea este código al ingresar al recinto.</p>
                </div>

                <a asp-controller="Home" asp-action="Index" class="btn btn-danger">Volver a cartelera</a>
            </div>
        </div>
    </div>
</section>

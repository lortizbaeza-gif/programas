@model Cine.Models.MiembroClub
@{ ViewData["Title"] = "Mi Club"; }
<section class="container py-5"><div class="row justify-content-center"><div class="col-lg-8"><div class="rounded-4 p-4 p-md-5 text-white shadow" style="background:linear-gradient(135deg,#111827,#8f1d3d);"><p class="text-uppercase mb-1">Membresía activa</p><h1 class="fw-bold">Club @Model.Nivel</h1><div class="row mt-4"><div class="col-md-6"><p class="mb-1">Socio</p><h4>@Model.Nombre</h4><p class="mb-1">Código de membresía</p><h3><code class="text-white">@Model.Codigo</code></h3></div><div class="col-md-6"><div class="bg-white text-dark rounded-4 p-3"><small>Descuento automático</small><h2 class="text-danger">@Model.DescuentoPorcentaje.ToString("0.##")%</h2><small>Puntos disponibles</small><h3>@Model.Puntos</h3></div></div></div><p class="mt-4 mb-0">Tus beneficios se aplicarán automáticamente durante el pago. Muestra este código en taquilla.</p></div><div class="d-flex gap-2 mt-4"><a asp-controller="Home" asp-action="Index" class="btn btn-danger">Ver cartelera</a><a asp-controller="Dulceria" asp-action="Index" class="btn btn-outline-danger">Ver promociones de dulcería</a><form asp-action="CerrarSesionClub" method="post"><button class="btn btn-outline-secondary">Salir de Mi Club</button></form></div></div></div></section>

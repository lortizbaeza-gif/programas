@model Cine.Models.MiembroClub
@{ ViewData["Title"] = "Contratar Club"; }
<section class="container py-5"><div class="row justify-content-center"><div class="col-lg-7"><div class="card club-signup-card border-0 shadow rounded-4 p-4"><h2 class="fw-bold">Contratar plan @Model.Nivel</h2><p class="text-muted">Pago simulado para demostración del sistema.</p><form asp-action="Inscribirse" method="post"><div asp-validation-summary="ModelOnly" class="text-danger"></div><input asp-for="Nivel" type="hidden"/><div class="row g-3"><div class="col-md-6"><label class="form-label">Nombre completo</label><input asp-for="Nombre" class="form-control" autocomplete="name" required/><span asp-validation-for="Nombre" class="text-danger"></span></div><div class="col-md-6"><label class="form-label">Correo</label><input asp-for="Email" type="email" class="form-control" autocomplete="email" required/><span asp-validation-for="Email" class="text-danger"></span></div><div class="col-md-6"><label class="form-label">Teléfono</label><input asp-for="Telefono" class="form-control" autocomplete="tel" required/></div><div class="col-md-6"><label class="form-label">Tarjeta (simulada)</label><input class="form-control" name="TarjetaSimulada" inputmode="numeric" autocomplete="cc-number" placeholder="**** **** **** 1234" required/></div></div><div class="alert alert-light border mt-4">Plan <strong>@Model.Nivel</strong>: @Model.DescuentoPorcentaje.ToString("0.##")% de descuento automático en boletos y dulcería.</div><button class="btn btn-danger w-100">Pagar y activar mi Club</button></form></div></div></div></section>
